# Production environment variables (Section 24.3)
# Real values are injected via CI/CD secrets at build/deploy time — this
# checked-in file only documents which keys exist and safe placeholders.
# Never put the Razorpay Key Secret or any server-side secret here — this
# bundle ships to the browser.

VITE_API_BASE_URL=https://api.railbite.in/api/v1
VITE_RAZORPAY_KEY_ID=rzp_live_placeholder_key_id
